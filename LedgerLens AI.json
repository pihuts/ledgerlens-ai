{
  "id": "d4e5f6a7-b8c9-4d0e-8f1a-2b3c4d5e6f70",
  "name": "LedgerLens AI - Invoice Data Extractor",
  "nodes": [
    {
      "id": "invoice-sticky",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -400,
        -500
      ],
      "parameters": {
        "width": 800,
        "height": 220,
        "content": "## LedgerLens AI\n\nUpload an invoice PDF, extract vendor, line items, totals, and payment terms with GPT-5.6 Luna, log it to Google Sheets, email a confirmation, and notify finance.\n\nReady to extend with image OCR, approval workflows, or ERP sync."
      },
      "typeVersion": 1
    },
    {
      "id": "invoice-form",
      "name": "Submit Invoice",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Invoice Upload",
        "formDescription": "Upload an invoice PDF for automatic data extraction.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your Email",
              "requiredField": true,
              "fieldType": "email"
            },
            {
              "fieldType": "file",
              "fieldLabel": "Invoice_File",
              "requiredField": true,
              "acceptFileTypes": ".pdf",
              "multipleFiles": false
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "typeVersion": 2.2
    },
    {
      "id": "invoice-extract",
      "name": "Extract Text from PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        720,
        0
      ],
      "parameters": {
        "options": {},
        "operation": "pdf",
        "binaryPropertyName": "Invoice_File"
      },
      "typeVersion": 1
    },
    {
      "id": "invoice-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1200,
        320
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.6-luna"
        },
        "options": {
          "temperature": 0,
          "timeout": 30000
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "invoice-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1200,
        560
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"vendor_name\":{\"type\":[\"string\",\"null\"]},\"vendor_email\":{\"type\":[\"string\",\"null\"]},\"vendor_address\":{\"type\":[\"string\",\"null\"]},\"invoice_number\":{\"type\":[\"string\",\"null\"]},\"invoice_date\":{\"type\":[\"string\",\"null\"]},\"due_date\":{\"type\":[\"string\",\"null\"]},\"currency\":{\"type\":[\"string\",\"null\"]},\"subtotal\":{\"type\":[\"number\",\"null\"]},\"tax\":{\"type\":[\"number\",\"null\"]},\"total\":{\"type\":[\"number\",\"null\"]},\"payment_terms\":{\"type\":[\"string\",\"null\"]},\"line_items\":{\"type\":[\"array\",\"null\"],\"items\":{\"type\":\"object\",\"properties\":{\"description\":{\"type\":\"string\"},\"quantity\":{\"type\":\"number\"},\"unit_price\":{\"type\":\"number\"},\"amount\":{\"type\":\"number\"}},\"required\":[\"description\",\"quantity\",\"unit_price\",\"amount\"]}},\"notes\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"vendor_name\",\"vendor_email\",\"vendor_address\",\"invoice_number\",\"invoice_date\",\"due_date\",\"currency\",\"subtotal\",\"tax\",\"total\",\"payment_terms\",\"line_items\",\"notes\"]}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "invoice-chain",
      "name": "Extract Invoice Data",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a meticulous accounting automation assistant. Extract every requested invoice field from the text. Preserve exact invoice numbers, dates, currency, and amounts. For line items, extract each row with description, quantity, unit price, and amount. If a value is missing, use null. Never invent amounts or vendors. Return valid JSON only."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "invoice-normalize",
      "name": "Normalize Invoice Output",
      "type": "n8n-nodes-base.code",
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || $input.first().json;\nconst form = $('Submit Invoice').first().json;\nconst str = v => v == null ? '' : String(v).trim();\nconst num = v => v == null || v === '' ? null : Number(v);\nconst email = str(form['Your Email']);\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Valid submitter email required');\nif (!str(raw.vendor_name) || !str(raw.invoice_number) || !str(raw.currency) || !Number.isFinite(num(raw.total))) throw new Error('Invoice identity, currency and total required');\nconst key = (str(raw.vendor_name) + '|' + str(raw.invoice_number)).toLowerCase();\nreturn [{json: {invoiceKey: key, runId: String($execution.id), submittedBy: email, submittedAt: new Date().toISOString(),\n  vendor_name: str(raw.vendor_name), vendor_email: str(raw.vendor_email), vendor_address: str(raw.vendor_address),\n  invoice_number: str(raw.invoice_number), invoice_date: str(raw.invoice_date), due_date: str(raw.due_date),\n  currency: str(raw.currency).toUpperCase(), subtotal: num(raw.subtotal), tax: num(raw.tax), total: num(raw.total),\n  payment_terms: str(raw.payment_terms), line_items: JSON.stringify(raw.line_items || []), notes: str(raw.notes)}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "invoice-sheets",
      "name": "Log Invoice to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        2640,
        0
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.INVOICE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invoices",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Submitted By": "={{ $json.submittedBy }}",
            "Submitted At": "={{ $json.submittedAt }}",
            "Vendor Name": "={{ $json.vendor_name }}",
            "Vendor Email": "={{ $json.vendor_email }}",
            "Vendor Address": "={{ $json.vendor_address }}",
            "Invoice Number": "={{ $json.invoice_number }}",
            "Invoice Date": "={{ $json.invoice_date }}",
            "Due Date": "={{ $json.due_date }}",
            "Currency": "={{ $json.currency }}",
            "Subtotal": "={{ $json.subtotal }}",
            "Tax": "={{ $json.tax }}",
            "Total": "={{ $json.total }}",
            "Payment Terms": "={{ $json.payment_terms }}",
            "Line Items": "={{ $json.line_items }}",
            "Notes": "={{ $json.notes }}",
            "Status": "=New",
            "Invoice Key": "={{ $json.invoiceKey }}",
            "Run ID": "={{ $json.runId }}"
          },
          "matchingColumns": [
            "Invoice Key"
          ]
        },
        "options": {}
      },
      "typeVersion": 4.5
    },
    {
      "id": "invoice-confirm",
      "name": "Confirm to Submitter",
      "type": "n8n-nodes-base.gmail",
      "position": [
        3360,
        0
      ],
      "parameters": {
        "sendTo": "={{ $('Normalize Invoice Output').first().json.submittedBy }}",
        "subject": "=Invoice {{ $('Normalize Invoice Output').first().json.invoice_number }} received",
        "message": "=Hi,\n\nWe received invoice {{ $('Normalize Invoice Output').first().json.invoice_number }} from {{ $('Normalize Invoice Output').first().json.vendor_name }} for {{ $('Normalize Invoice Output').first().json.currency }} {{ $('Normalize Invoice Output').first().json.total }}.\n\nStatus: New\n\nOur finance team is reviewing it.",
        "options": {}
      },
      "typeVersion": 2.1
    },
    {
      "id": "invoice-finance",
      "name": "Notify Finance Team",
      "type": "n8n-nodes-base.gmail",
      "position": [
        3600,
        0
      ],
      "parameters": {
        "sendTo": "={{ $env.FINANCE_EMAIL_TO }}",
        "subject": "=New invoice {{ $('Normalize Invoice Output').first().json.invoice_number }} - {{ $('Normalize Invoice Output').first().json.vendor_name }}",
        "message": "=Invoice: {{ $('Normalize Invoice Output').first().json.invoice_number }}\nVendor: {{ $('Normalize Invoice Output').first().json.vendor_name }}\nDate: {{ $('Normalize Invoice Output').first().json.invoice_date }}\nDue: {{ $('Normalize Invoice Output').first().json.due_date }}\nTotal: {{ $('Normalize Invoice Output').first().json.currency }} {{ $('Normalize Invoice Output').first().json.total }}\nPayment terms: {{ $('Normalize Invoice Output').first().json.payment_terms }}\n\nLine items:\n{{ $('Normalize Invoice Output').first().json.line_items }}",
        "options": {}
      },
      "typeVersion": 2.1
    },
    {
      "id": "preflight",
      "name": "Preflight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const env = $env;\nconst enabled = env.LEDGERLENS_ENABLED === 'true';\nconst dryRun = env.LEDGERLENS_DRY_RUN !== 'false';\nconst required = [\"INVOICE_SHEET_ID\", \"FINANCE_EMAIL_TO\", \"LEDGERLENS_ALERT_EMAIL_TO\"];\nif (enabled && !dryRun) {\n  const missing = required.filter(key => !String(env[key] || '').trim());\n  if (missing.length) throw new Error('Missing configuration: ' + missing.join(', '));\n}\nif (enabled && !dryRun) {\n  const email = String($input.first().json['Your Email'] || '');\n  const file = $input.first().binary?.Invoice_File;\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Valid submitter email required');\n  if (!file || file.mimeType !== 'application/pdf') throw new Error('PDF invoice required');\n}\nconst runId = String($execution.id);\nconst status = !enabled ? 'disabled' : dryRun ? 'dry_run' : 'running';\nconsole.log(JSON.stringify({timestamp: new Date().toISOString(), runId, workflow: 'LEDGERLENS', status}));\nconst first = $input.first();\nreturn [{json: {...first.json, runId, status, runLive: status === 'running'}, ...(first.binary ? {binary: first.binary} : {})}];"
      }
    },
    {
      "id": "run-live?",
      "name": "Run live?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "live-run",
              "leftValue": "={{ $json.runLive }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "stopped-or-dry-run",
      "name": "Stopped or dry run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -300
      ],
      "parameters": {
        "jsCode": "console.log(JSON.stringify({timestamp: new Date().toISOString(), runId: $json.runId, result: $json.status})); return [{json: {status: $json.status, runId: $json.runId}}];"
      }
    },
    {
      "id": "find-existing-invoices",
      "name": "Find existing invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
