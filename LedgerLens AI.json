    },
    {
      "id": "audit-confirm-to-submitter",
      "name": "Audit confirm to submitter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3840,
        0
      ],
      "parameters": {
        "jsCode": "console.log(JSON.stringify({timestamp:new Date().toISOString(), runId:String($execution.id), result:'sent', action:'Confirm to Submitter'})); return $input.all();"
      }
    },
    {
      "id": "audit-notify-finance-team",
      "name": "Audit notify finance team",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4080,
        0
      ],
      "parameters": {
        "jsCode": "console.log(JSON.stringify({timestamp:new Date().toISOString(), runId:String($execution.id), result:'sent', action:'Notify Finance Team'})); return $input.all();"
      }
