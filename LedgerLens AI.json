        },
        "sheetName": {
          "__rl": true,
          "value": "Invoices",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Invoice Key",
              "lookupValue": "={{ $json.invoiceKey }}"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "new-invoices?",
      "name": "New invoices?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "new-record",
              "leftValue": "={{ !$json['Invoice Key'] }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "restore-input-for-invoices",
      "name": "Restore input for invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "jsCode": "return [{json: $('Normalize Invoice Output').first().json}];"
      }
    },
    {
      "id": "already-recorded",
      "name": "Already recorded",
